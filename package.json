{
  "name": "sfu-peer-mentor-hub",
  "version": "1.0.0",
  "description": "SFU Peer Mentor Hub V1: sourced resources, editable posters and reviewed course planning",
  "main": "index.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "preview": "vite preview --host 127.0.0.1",
    "verify:resources": "tsx scripts/verify-resources.ts",
    "courses:import": "tsx scripts/course-import/import.ts",
    "courses:validate": "tsx scripts/course-import/maintenance.ts validate",
    "courses:discover": "tsx scripts/course-import/cli.ts discover",
    "courses:sync": "tsx scripts/course-import/cli.ts sync",
    "courses:sync:all": "tsx scripts/course-import/cli.ts sync all",
    "courses:publish": "tsx scripts/course-import/cli.ts publish",
    "courses:report": "tsx scripts/course-import/maintenance.ts report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/errold727/SFU-Peer-Mentor-Hub.git"
  },
  "keywords": [],
